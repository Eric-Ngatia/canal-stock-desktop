# Copier en .env si besoin de surcharger les valeurs par défaut.
# L'app fonctionne sans ce fichier : ces valeurs ont un défaut en dur dans le code.

# Montant de la commission versée à un apporteur d'affaires par décodeur vendu (FCFA).
COMMISSION_APPORTEUR=1500

# Nom du fichier SQLite, créé dans le dossier de données utilisateur d'Electron
# (app.getPath('userData')). Ne pas mettre de chemin absolu : géré par Electron.
DB_FILENAME=canal-stock.sqlite
