{
  "name": "canal-stock-desktop",
  "version": "0.1.0",
  "description": "Gestion de stock et vente de décodeurs/paraboles Canal+ — app desktop hors ligne",
  "author": "Eric Ngatia <ericonstantngatia@gmail.com>",
  "main": "src/main/main.js",
  "scripts": {
    "predev": "electron-rebuild -f -w better-sqlite3",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev:electron:wait": "wait-on http://localhost:5173 && npm run dev:electron",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron:wait\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "postbuild": "npm rebuild better-sqlite3",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "daisyui": "^4.12.10",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.8.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.canalstock.desktop",
    "productName": "Gestion Stock Canal+",
    "files": [
      "**/*",
      "!test/**/*",
      "!.claude/**/*",
      "!.plans/**/*",
      "!.git/**/*",
      "!*.sqlite",
      "!.env*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
